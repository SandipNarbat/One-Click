// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
  // output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")

}



// ─────────────────────────────────────────
// SUPPLIER
// ─────────────────────────────────────────
model Supplier {
  id            Int       @id @default(autoincrement())
  supplierId    String    @unique  // SUP-0021
  supplierName  String
  contactPerson String?
  email         String?
  mobile        String?
  landline      String?
  address       String?
  state         String?
  gstTin        String?
  aadharNo      String?
  panNo         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations
  items         Item[]
  doaRecords    DOARecord[]
  purchase      Purchase[]    // AMAN GUPTA

  @@map("suppliers")
}

// ─────────────────────────────────────────
// CUSTOMER
// ─────────────────────────────────────────
model Customer {
  id           Int       @id @default(autoincrement())
  customerId   String    @unique  // CUST-0042
  customerName String
  email        String?
  contactNo    String?
  mobileNo     String?
  address      String?
  state        String?
  gstTin       String?
  aadharNo     String?
  panNo        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  // Relations
  sales        Sale[]

  @@map("customers")
}

// ─────────────────────────────────────────
// PRODUCT (Category level - e.g. MOBILES, TABLETS)
// ─────────────────────────────────────────
model Product {
  id              Int       @id @default(autoincrement())
  prodCode        String    @unique  // 1, 2, 3...
  productName     String            // MOBILES, DIGI CAM
  productType     ProductType       // SINGLE or MULTIPLE
  hsnCode         String?           // 85171300
  productCategory String?
  gstPercentage   Float?            // 18, 28
  organisation    String?           // SHREE SONY NX
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Relations
  items           Item[]
  purchaseItems PurchaseItem[] // AMAN GUPTA
  stockLedgers    StockLedger[] // AMAN GUPTA

  @@map("products")
}

// ─────────────────────────────────────────
// ITEM (Individual stock entry with IMEI etc.)
// ─────────────────────────────────────────
model Item {
  id          Int       @id @default(autoincrement())
  itemId      String    @unique   // ITM-4029
  productId   Int
  product     Product   @relation(fields: [productId], references: [id])
  supplierId  Int?
  supplier    Supplier? @relation(fields: [supplierId], references: [id])
  model       String?              // Eco Volt Neo, 512GB
  brand       String?              // Samsung, Luminous
  colour      String?              // Phantom Black
  imeiNo      String?   @unique
  dp          Float?               // Dealer Price
  salePrice   Float?
  tax         String?              // Standard (20%)
  quantity    Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Relations
  priceHistory PriceHistory[]

  @@map("items")
}

// ─────────────────────────────────────────
// PRICE HISTORY (for Price Drop / Change Master)
// ─────────────────────────────────────────
model PriceHistory {
  id          Int      @id @default(autoincrement())
  itemId      Int
  item        Item     @relation(fields: [itemId], references: [id])
  oldDp       Float?
  newDp       Float?
  oldSalePrice Float?
  newSalePrice Float?
  oldImei     String?
  newImei     String?
  remark      String?
  changedAt   DateTime @default(now())

  @@map("price_history")
}

// ─────────────────────────────────────────
// DOA RECORD
// ─────────────────────────────────────────
model DOARecord {
  id          Int      @id @default(autoincrement())
  supplierId  Int
  supplier    Supplier @relation(fields: [supplierId], references: [id])
  invoiceNo   String
  invoiceDate DateTime
  totalQty    Int
  totalAmount Float
  itemId      String?
  productName String?
  createdAt   DateTime @default(now())

  @@map("doa_records")
}

// ─────────────────────────────────────────
// SALES PERSON
// ─────────────────────────────────────────
model SalesPerson {
  id         Int      @id @default(autoincrement())
  employeeId String   @unique  // EMP-1042
  name       String
  mobile     String?
  contactNo  String?
  email      String?
  address    String?
  visible    Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  sales      Sale[]

  @@map("sales_persons")
}

// ─────────────────────────────────────────
// SERVICE CENTER
// ─────────────────────────────────────────
model ServiceCenter {
  id              Int      @id @default(autoincrement())
  serialNo        String   @unique
  productType     String?
  brandName       String?
  serviceCentreNo String?
  createdAt       DateTime @default(now())

  @@map("service_centers")
}

// ─────────────────────────────────────────
// SALE (for Report)
// ─────────────────────────────────────────
model Sale {
  id           Int         @id @default(autoincrement())
  invoiceNo    String      @unique
  invoiceDate  DateTime
  customerId   Int?
  customer     Customer?   @relation(fields: [customerId], references: [id])
  salesPersonId Int?
  salesPerson  SalesPerson? @relation(fields: [salesPersonId], references: [id])
  itemId       String?
  productName  String?
  model        String?
  brand        String?
  quantity     Int
  amount       Float
  createdAt    DateTime    @default(now())

  @@map("sales")
}

// ─────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────
enum ProductType {
  SINGLE
  MULTIPLE
}



//AMAN GUPTA
// ==========================================
// PURCHASE ENTRY (HEADER) AMAN
// ==========================================
model Purchase {
  id              Int      @id @default(autoincrement())

  purchaseNo      String   @unique
  type            String?

  invoiceNo       String
  invoiceDate     DateTime
  receivedDate    DateTime?

  supplierId      Int

  supplier        Supplier @relation(fields: [supplierId], references: [id])

  totalItems      Int      @default(0)
  totalQty        Int      @default(0)

  grossAmount     Float
  discountAmount  Float?   @default(0)

  cgstAmount      Float?   @default(0)
  sgstAmount      Float?   @default(0)
  igstAmount      Float?   @default(0)

  otherCharges    Float?   @default(0)

  netAmount       Float

  remarks         String?

  status          PurchaseStatus @default(SAVED)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  purchaseItems   PurchaseItem[]

  @@map("purchases")
}

// ==========================================
// PURCHASE ITEM DETAILS
// ==========================================
model PurchaseItem {
  id                 Int      @id @default(autoincrement())

  purchaseId         Int
  purchase           Purchase @relation(fields: [purchaseId], references: [id])

  productId          Int?
  product            Product? @relation(fields: [productId], references: [id])

  company            String?
  partNo             String?

  barcode            String?

  productName        String
  brand              String?
  model              String?
  colour             String?

  qty                Int      @default(1)

  purchaseRate       Float

  discountPercent    Float?   @default(0)
  discountAmount     Float?   @default(0)

  cgstPercent        Float?   @default(0)
  cgstAmount         Float?   @default(0)

  sgstPercent        Float?   @default(0)
  sgstAmount         Float?   @default(0)

  igstPercent        Float?   @default(0)
  igstAmount         Float?   @default(0)

  gstPercent         Float?   @default(0)

  dpAmount           Float?

  salePrice          Float?

  amount             Float

  createdAt          DateTime @default(now())

  imeis              PurchaseIMEI[]

  @@map("purchase_items")
}

// ==========================================
// IMEI DETAILS
// ==========================================
model PurchaseIMEI {
  id               Int @id @default(autoincrement())

  purchaseItemId   Int
  purchaseItem     PurchaseItem @relation(fields: [purchaseItemId], references: [id])

  imeiNo           String @unique

  createdAt        DateTime @default(now())

  @@map("purchase_imeis")
}

// ==========================================
// STOCK LEDGER
// ==========================================
model StockLedger {
  id               Int @id @default(autoincrement())

  productId        Int
  product          Product @relation(fields: [productId], references: [id])

  transactionType  String
  transactionNo    String

  qtyIn            Int @default(0)
  qtyOut           Int @default(0)

  rate             Float?

  createdAt        DateTime @default(now())

  @@map("stock_ledger")
}

// ==========================================
// ENUMS
// ==========================================
enum PurchaseStatus {
  DRAFT
  SAVED
  CANCELLED
}

// ─────────────────────────────────────────
// VOUCHER MASTER
// ─────────────────────────────────────────
model VoucherMaster {
  id            Int       @id @default(autoincrement())
  voucherNo     String    @unique
  voucherDate   DateTime
  paidTo        String?
  particulars   String?
  amount        Float     @default(0)
  amountInWords String?
  mode          String?
  transNo       String?
  transDate     DateTime?
  bankName      String?
  passedBy      String?
  status        String    @default("DRAFT")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@map("voucher_masters")
}

// ─────────────────────────────────────────
// PETTY CASH DEPOSIT
// ─────────────────────────────────────────
model PettyCashDeposit {
  id            Int       @id @default(autoincrement())
  voucherNo     String    @unique
  depositDate   DateTime
  depositedFrom String?
  particulars   String?
  amount        Float     @default(0)
  amountInWords String?
  mode          String?
  transNo       String?
  transDate     DateTime?
  bankName      String?
  passedBy      String?
  status        String    @default("DRAFT")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@map("petty_cash_deposits")
}